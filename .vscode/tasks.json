{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Plugin",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/PropHunt/PropHunt.csproj",
				"--output",
